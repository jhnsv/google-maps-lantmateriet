{
  "manifest_version": 2,
  "name": "Google Maps → Lantmäteriet",
  "version": "1.7.7",
  "description": "Öppna vald Google Maps-punkt i Lantmäteriets Min Karta.",
  "permissions": [
    "storage",
    "https://www.google.se/*",
    "https://www.google.com/*",
    "https://maps.google.com/*",
    "https://minkarta.lantmateriet.se/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.se/maps/*",
        "https://www.google.com/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "google-maps.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://minkarta.lantmateriet.se/*"
      ],
      "js": [
        "min-karta.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "google-maps-lantmateriet@local",
      "update_url": "https://raw.githubusercontent.com/jhnsv/google-maps-lantmateriet/main/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "locationInfo"
        ]
      }
    }
  }
}
